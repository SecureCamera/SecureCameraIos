<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Export compliance: SnapSafe uses non-exempt encryption (AES-256-GCM via
	     CryptoKit is its core feature), but ITSAppUsesNonExemptEncryption is
	     deliberately NOT set here. Declaring it without a matching
	     ITSEncryptionExportComplianceCode makes App Store Connect reject the
	     upload (error 90592), and the app has no approved encryption
	     documentation/code yet. Leaving the key out makes App Store Connect ask
	     the export compliance questions per build; answer them truthfully
	     (uses encryption: yes, standard algorithms). If App Store Connect later
	     issues a code, add both keys back together. -->
</dict>
</plist>
