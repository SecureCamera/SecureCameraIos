<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- SnapSafe encrypts user media with AES-256-GCM (CryptoKit) as its core
	     feature, which is NOT exempt encryption, so this must be true.
	     App Store Connect rejects an upload that declares this without an
	     ITSEncryptionExportComplianceCode matching the app's approved
	     encryption documentation (altool error 90592). -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<true/>
</dict>
</plist>
